# IMF Environment Configuration
# Copy to .env and fill in production values.
# Never commit .env with real secrets. VITE_SUPABASE_ANON_KEY is the public
# browser key (safe to expose; protected by RLS) and may be set in CI.

# Supabase project (Ordocom)
VITE_SUPABASE_URL=https://dtxmuvsrrywpcchvlacv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Admin PIN for the teacher cabinet unlock step
VITE_ADMIN_PIN=6138

# GitHub repository for publishing schedules (owner/repo format)
VITE_GITHUB_REPO=telikuy070-collab/imf

# Git branch to publish schedules to
VITE_GITHUB_BRANCH=main

# Server-only: Supabase service role key (Edge Functions / seed script)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: Supabase Personal Access Token (CLI / migrations)
SUPABASE_ACCESS_TOKEN=

# Server-only: GitHub Personal Access Token (admin publishing via Contents API)
GITHUB_TOKEN=